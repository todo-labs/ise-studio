{
  "name": "ise-studio",
  "version": "0.1.0",
  "private": true,
  "description": "ISE Studio - An open-source, web-based IDE for OpenSCAD with AI-powered assistance",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "cd apps/studio && bun run build",
    "check": "cd apps/studio && bun run check",
    "dev": "cd apps/studio && bun run dev",
    "format:check": "cd apps/studio && bun run format:check",
    "format:write": "cd apps/studio && bun run format:write",
    "lint": "cd apps/studio && bun run lint",
    "lint:fix": "cd apps/studio && bun run lint:fix",
    "preview": "cd apps/studio && bun run preview",
    "smoke:browser": "./scripts/playwright-smoke.sh",
    "test": "bun test",
    "typecheck": "cd apps/studio && bun run typecheck",
    "workspaces:build": "turbo run build",
    "workspaces:dev": "turbo run dev",
    "workspaces:lint": "turbo run lint",
    "workspaces:typecheck": "turbo run typecheck"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.244",
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@types/three": "^0.179.0",
    "@tanstack/react-virtual": "^3.13.12",
    "ai": "^6.0.242",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^3.0.6",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.178.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  }
}
